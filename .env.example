# --- Required ---
# Password for the admin account. Change this to a strong secret before
# starting the container the first time. It is used both for the web admin
# panel (argon2-hashed at rest) and for Subsonic API token auth (plaintext,
# stored in the SQLite DB, needed by the Subsonic protocol).
ADMIN_PASSWORD=change-me-please

# --- Optional ---
ADMIN_USER=admin
HTTP_PORT=4040

# Do NOT change these unless you also update docker-compose volumes.
# MUSIC_DIR=/music
# DATA_DIR=/data
